# DeepSeek
DEEPSEEK_API_KEY=sk-...
TRANSCRIPTION_PROVIDER=local
OPENAI_API_KEY=sk-...
WHISPER_MODEL=whisper-1
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8

# ElevenLabs
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Exotel
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_CALLER_ID=
EXOTEL_FLOW_ID=
EXOTEL_BASE_URL=api.exotel.com

# Supabase (get from Supabase → Settings → Database → Connection String → URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# App
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=make-this-a-long-random-string
PUBLIC_BASE_URL=https://your-public-backend-url.ngrok-free.app

# Timezone
TIMEZONE=Asia/Kolkata
# Razorpay TEST keys only. Never put the secret in Android.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional backend-owned pricing catalog. Include exactly starter, plus, business.
# PLAN_CATALOG_JSON={"starter":{"name":"Personal Starter","edition":"personal","price_paise":4900,"credits":10,"groups":false,"campaigns":false},"plus":{"name":"Personal Plus","edition":"personal","price_paise":19900,"credits":50,"groups":false,"campaigns":false},"business":{"name":"Business","edition":"business","price_paise":69900,"credits":200,"groups":true,"campaigns":true}}
# Optional per-recipient provider estimate shown before campaign confirmation.
EXOTEL_ESTIMATED_COST_PAISE=
